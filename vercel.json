{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,assets/**,test_*.py,prepare_*.py,verify_live.py,README.md,__pycache__/**,.git/**}"
    }
  }
}
